<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lilac_green_gradient">

    <!-- Top Header: Logo -->
    <ImageView
        android:id="@+id/galleryLogo"
        android:layout_width="74dp"
        android:layout_height="78dp"
        android:src="@drawable/ily_photo_logo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:background="#FFFFFF"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp" />

    <!-- Top Header: Title "ILY PHOTO." -->
    <TextView
        android:id="@+id/galleryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ily_photo_title"
        android:textColor="@color/white"
        android:textSize="29sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toEndOf="@id/galleryLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/galleryLogo"
        app:layout_constraintBottom_toBottomOf="@id/galleryLogo" />

    <!-- Top Divider above "GALLERY" -->
    <View
        android:id="@+id/dividerGalleryTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/galleryLogo" />

    <!-- Section Title: "GALLERY" -->
    <TextView
        android:id="@+id/gallerySectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerGalleryTop" />

    <!-- Bottom Divider below "GALLERY" -->
    <View
        android:id="@+id/dividerGalleryBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gallerySectionLabel" />

    <!-- Dropdown Selector "EVENT NAME" -->
    <LinearLayout
        android:id="@+id/btnEventNameDropdown"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/dropdown_pill_background"
        android:elevation="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="26dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerGalleryBottom">

        <TextView
            android:id="@+id/tvSelectedEventName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/event_name"
            android:textColor="@color/brand_text_dark"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_drop_down"
            android:contentDescription="Select Event"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Gallery Thumbnail Cards Grid -->
    <LinearLayout
        android:id="@+id/galleryGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEventNameDropdown">

        <!-- Top Thumbnail (Single item on left, exactly as in mockup) -->
        <FrameLayout
            android:id="@+id/galleryItem1"
            android:layout_width="150dp"
            android:layout_height="110dp"
            android:background="@drawable/gallery_image_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_image_placeholder"
                android:contentDescription="Gallery Photo 1" />
        </FrameLayout>

        <!-- Bottom Thumbnails (Two items side-by-side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/galleryItem2"
                android:layout_width="150dp"
                android:layout_height="110dp"
                android:background="@drawable/gallery_image_card_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_image_placeholder"
                    android:contentDescription="Gallery Photo 2" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/galleryItem3"
                android:layout_width="150dp"
                android:layout_height="110dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/gallery_image_card_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_image_placeholder"
                    android:contentDescription="Gallery Photo 3" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- "Download full Gallery" Pill Button -->
    <TextView
        android:id="@+id/btnDownloadGallery"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/login_button_background"
        android:elevation="4dp"
        android:gravity="center"
        android:text="@string/download_full_gallery"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@drawable/bottom_nav_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Search Tab -->
        <FrameLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search" />
        </FrameLayout>

        <!-- Settings Tab -->
        <FrameLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </FrameLayout>

        <!-- Menu Tab -->
        <FrameLayout
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/menu" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
