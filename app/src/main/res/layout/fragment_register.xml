<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lilac_green_gradient">

    <!-- Ily Photo logo -->
    <ImageView
        android:id="@+id/registerLogo"
        android:layout_width="74dp"
        android:layout_height="78dp"
        android:src="@drawable/ily_photo_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Ily Photo logo"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="68dp" />

    <!-- Main registration panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/registerPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/login_panel_background"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="164dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Login and Register tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/loginTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Login"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/registerTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Register"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:paddingBottom="4dp" />

                </LinearLayout>

                <!-- Form heading -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please enter details to create account"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp" />

                <!-- First name and surname -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <EditText
                        android:id="@+id/firstNameInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/login_input_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp"
                        android:hint="First Name"
                        android:textColor="#212121"
                        android:textColorHint="#757575"
                        android:textSize="14sp"
                        android:inputType="textPersonName"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/surnameInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/login_input_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp"
                        android:hint="Surname"
                        android:textColor="#212121"
                        android:textColorHint="#757575"
                        android:textSize="14sp"
                        android:inputType="textPersonName"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- Email -->
                <EditText
                    android:id="@+id/registerEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/login_input_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Email Address"
                    android:textColor="#212121"
                    android:textColorHint="#757575"
                    android:textSize="14sp"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

                <!-- Password -->
                <EditText
                    android:id="@+id/registerPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/login_input_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Password (min 6 characters)"
                    android:textColor="#212121"
                    android:textColorHint="#757575"
                    android:textSize="14sp"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <!-- Date of birth label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date of Birth"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp" />

                <!-- Date of birth field -->
                <EditText
                    android:id="@+id/dateOfBirthInput"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/login_input_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="DD/MM/YYYY"
                    android:textColor="#212121"
                    android:textColorHint="#757575"
                    android:textSize="14sp"
                    android:inputType="date"
                    android:singleLine="true" />

                <!-- Service area: Cape Town only -->
                <TextView
                    android:id="@+id/cityField"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/login_input_background"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Cape Town (Default City)"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:drawableEnd="@null" />

                <!-- Sign Up button -->
                <TextView
                    android:id="@+id/signUpButton"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/login_button_background"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="Sign Up"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Bottom login link -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Have an account already?"
                        android:textColor="#211916"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/backToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Login"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
