<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lilac_green_gradient">

    <!-- Top Header: Logo -->
    <ImageView
        android:id="@+id/bookingLogo"
        android:layout_width="74dp"
        android:layout_height="78dp"
        android:src="@drawable/ily_photo_logo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:background="#FFFFFF"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp" />

    <!-- Top Header: Title "ILY PHOTO." -->
    <TextView
        android:id="@+id/bookingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ily_photo_title"
        android:textColor="@color/white"
        android:textSize="29sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toEndOf="@id/bookingLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bookingLogo"
        app:layout_constraintBottom_toBottomOf="@id/bookingLogo" />

    <!-- Top Divider above "BOOKING" -->
    <View
        android:id="@+id/dividerBookingTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bookingLogo" />

    <!-- Section Title: "BOOKING" -->
    <TextView
        android:id="@+id/bookingSectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/booking"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerBookingTop" />

    <!-- Bottom Divider below "BOOKING" -->
    <View
        android:id="@+id/dividerBookingBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bookingSectionLabel" />

    <!-- Tagline: "CAPTURING EVERY MOMENT" -->
    <TextView
        android:id="@+id/bookingTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/capturing_every_moment"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerBookingBottom" />

    <!-- "Select a date" Label -->
    <TextView
        android:id="@+id/tvSelectDateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_a_date"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bookingTagline" />

    <!-- Calendar View Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCalendar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="5dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSelectDateLabel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Calendar Blue Header Banner -->
            <LinearLayout
                android:id="@+id/calendarHeaderBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/calendar_header_background"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvCalendarYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026"
                    android:textColor="#C5D7FF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCalendarSelectedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aug 28th"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Month Bar: < Sept 2026 > -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="Previous Month"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvCalendarMonthYear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sept 2026"
                    android:textColor="#1948B8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Next Month"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Weekday Headers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="7"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sun"
                    android:textColor="#668CD9"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mon"
                    android:textColor="#668CD9"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tues"
                    android:textColor="#668CD9"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wed"
                    android:textColor="#668CD9"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thur"
                    android:textColor="#668CD9"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fri"
                    android:textColor="#668CD9"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sat"
                    android:textColor="#668CD9"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Table of Days -->
            <TableLayout
                android:id="@+id/calendarTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="12dp">

                <!-- Row 1 -->
                <TableRow android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/dayPrev30" android:text="30" android:textColor="#5FA8E8" android:textSize="11sp" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day01" android:text="01" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day02" android:text="02" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day03" android:text="03" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day04" android:text="04" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day05" android:text="05" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day06" android:text="06" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                </TableRow>

                <!-- Row 2 -->
                <TableRow android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/day07" android:text="07" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day08" android:text="08" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day09" android:text="09" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day10" android:text="10" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day11" android:text="11" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day12" android:text="12" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day13" android:text="13" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                </TableRow>

                <!-- Row 3: 15 is booked event -->
                <TableRow android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/day14" android:text="14" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day15" android:text="15" android:textColor="#1948B8" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day16" android:text="16" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day17" android:text="17" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day18" android:text="18" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day19" android:text="19" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day20" android:text="20" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                </TableRow>

                <!-- Row 4 -->
                <TableRow android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/day21" android:text="21" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day22" android:text="22" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day23" android:text="23" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day24" android:text="24" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day25" android:text="25" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day26" android:text="26" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day27" android:text="27" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                </TableRow>

                <!-- Row 5: 28th active, next month in blue -->
                <TableRow android:layout_height="32dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/day28" android:text="28" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day29" android:text="29" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day30" android:text="30" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/day31" android:text="31" android:textColor="@color/brand_text_dark" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/dayNext01" android:text="01" android:textColor="#5FA8E8" android:textSize="11sp" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/dayNext02" android:text="02" android:textColor="#5FA8E8" android:textSize="11sp" android:gravity="center" android:padding="6dp" />
                    <TextView android:id="@+id/dayNext03" android:text="03" android:textColor="#5FA8E8" android:textSize="11sp" android:gravity="center" android:padding="6dp" />
                </TableRow>
            </TableLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- "Make Booking" Pill Button -->
    <TextView
        android:id="@+id/btnMakeBooking"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/login_button_background"
        android:elevation="4dp"
        android:gravity="center"
        android:text="@string/make_booking"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar" />

    <!-- Conflict Dialog Modal Overlay Container (hidden by default, shown on conflict) -->
    <FrameLayout
        android:id="@+id/conflictOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/dialogConflict"
            layout="@layout/dialog_booking_conflict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@drawable/bottom_nav_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Search Tab -->
        <FrameLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search" />
        </FrameLayout>

        <!-- Settings Tab -->
        <FrameLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </FrameLayout>

        <!-- Menu Tab -->
        <FrameLayout
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/menu" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
