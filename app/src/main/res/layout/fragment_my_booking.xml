<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lilac_green_gradient">

    <!-- Top Header: Logo -->
    <ImageView
        android:id="@+id/myBookingLogo"
        android:layout_width="74dp"
        android:layout_height="78dp"
        android:src="@drawable/ily_photo_logo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:background="#FFFFFF"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp" />

    <!-- Top Header: Title "ILY PHOTO." -->
    <TextView
        android:id="@+id/myBookingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ily_photo_title"
        android:textColor="@color/white"
        android:textSize="29sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toEndOf="@id/myBookingLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/myBookingLogo"
        app:layout_constraintBottom_toBottomOf="@id/myBookingLogo" />

    <!-- Top Divider above "MY BOOKING" -->
    <View
        android:id="@+id/dividerMyBookingTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myBookingLogo" />

    <!-- Section Title: "MY BOOKING" -->
    <TextView
        android:id="@+id/myBookingSectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_booking"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerMyBookingTop" />

    <!-- Bottom Divider below "MY BOOKING" -->
    <View
        android:id="@+id/dividerMyBookingBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myBookingSectionLabel" />

    <!-- Tagline: "CAPTURING EVERY MOMENT" -->
    <TextView
        android:id="@+id/myBookingTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/capturing_every_moment"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerMyBookingBottom" />

    <!-- Scrollable container for the booking details card -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myBookingTagline"
        app:layout_constraintBottom_toTopOf="@id/btnMakeNewBooking">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Booking Details Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardBookingDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_card_background"
                android:elevation="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- UPCOMING EVENT -->
                <TextView
                    android:id="@+id/tvUpcomingEvent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upcoming_event"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- BOOKING: 04 SEPETEMBER -->
                <TextView
                    android:id="@+id/tvBookingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_booking"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvUpcomingEvent" />

                <!-- DETAILS -->
                <TextView
                    android:id="@+id/tvDetailsHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/details"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBookingDate" />

                <!-- Detail Rows Form -->
                <LinearLayout
                    android:id="@+id/layoutDetailRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDetailsHeading">

                    <!-- Event Type Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.1"
                            android:text="@string/event_type_label"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEventTypeValue"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1.4"
                            android:background="@drawable/input_grey_background"
                            android:text="Matric Ball"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="12sp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                    </LinearLayout>

                    <!-- Location Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.1"
                            android:text="@string/location_label"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLocationValue"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1.4"
                            android:background="@drawable/input_grey_background"
                            android:text="Strandfontein, Cape Town"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="12sp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                    </LinearLayout>

                    <!-- Price Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.1"
                            android:text="@string/price_label"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPriceValue"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1.4"
                            android:background="@drawable/input_grey_background"
                            android:text="R400.00 (2 Hours)"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="12sp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                    </LinearLayout>

                    <!-- Payment Details Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.1"
                            android:text="@string/payment_details_label"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPaymentDetailsValue"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1.4"
                            android:background="@drawable/input_grey_background"
                            android:text="Paid via EFT"
                            android:textColor="@color/brand_text_dark"
                            android:textSize="12sp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- "EDIT" Pill Button inside Card -->
                <TextView
                    android:id="@+id/btnEditBooking"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/login_button_background"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:text="@string/edit"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/layoutDetailRows"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

    <!-- "MAKE A BOOKING" Pill Button below Card -->
    <TextView
        android:id="@+id/btnMakeNewBooking"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/login_button_background"
        android:elevation="4dp"
        android:gravity="center"
        android:text="@string/make_a_booking"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@drawable/bottom_nav_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Search Tab -->
        <FrameLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search" />
        </FrameLayout>

        <!-- Settings Tab -->
        <FrameLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </FrameLayout>

        <!-- Menu Tab -->
        <FrameLayout
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/menu" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
